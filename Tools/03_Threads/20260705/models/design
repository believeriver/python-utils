class Switch(Base):
    __tablename__ = "switches"

    id = Column(Integer, primary_key=True)
    hostname = Column(String(64), unique=True, nullable=False, index=True)
    ip_address = Column(String(45), unique=True, nullable=False, index=True)
    hardware_model = Column(String(32), nullable=False)
    base_mac_address = Column(String(17), nullable=True, index=True)
    service_tag = Column(String(32), unique=True, nullable=True)
    location = Column(String(128), nullable=True)
    switch_type = Column(String(8), nullable=False)
    role = Column(String(16), nullable=False)

    data_vlan = Column(Integer, nullable=True)          # 追加：データVLAN ID
    ntp_servers = Column(String(128), nullable=True)    # 追加：カンマ区切りで複数格納（例: "10.1.1.1,10.1.1.2"）

    is_active = Column(Boolean, default=True, nullable=False)
    created_at = Column(DateTime, default=datetime.utcnow, nullable=False)
    updated_at = Column(DateTime, default=datetime.utcnow, onupdate=datetime.utcnow, nullable=False)


 class SwitchConfigItem(Base):
    __tablename__ = "switch_config_items"
    __table_args__ = (
        UniqueConstraint("switch_id", "item_type", "value", name="uq_switch_item_type_value"),
    )

    id = Column(Integer, primary_key=True)
    switch_id = Column(Integer, ForeignKey("switches.id"), nullable=False, index=True)
    item_type = Column(String(32), nullable=False, index=True)  # "ntp_server", "syslog_server", "snmp_community" など
    value = Column(String(128), nullable=False)
    collected_at = Column(DateTime, nullable=False)

    switch = relationship("Switch")


 from sqlalchemy import ForeignKey, UniqueConstraint
from sqlalchemy.orm import relationship


class CdpNeighbor(Base):
    __tablename__ = "cdp_neighbors"
    __table_args__ = (
        UniqueConstraint("switch_id", "local_interface", name="uq_switch_local_interface"),
    )

    id = Column(Integer, primary_key=True)
    switch_id = Column(Integer, ForeignKey("switches.id"), nullable=False, index=True)
    local_interface = Column(String(32), nullable=False)        # 例: "Gi1/0/24"

    neighbor_hostname_raw = Column(String(128), nullable=False)  # CDPが返したそのままのdevice_id
    neighbor_interface = Column(String(32), nullable=True)
    neighbor_platform = Column(String(64), nullable=True)        # 例: "cisco WS-C2960L"
    neighbor_chassis_mac = Column(String(17), nullable=True, index=True)  # CDPのchassis_id

    resolved_switch_id = Column(Integer, ForeignKey("switches.id"), nullable=True)  # 名前解決できた場合のFK

    last_seen = Column(DateTime, default=datetime.utcnow, onupdate=datetime.utcnow, nullable=False)

    switch = relationship("Switch", foreign_keys=[switch_id])
    resolved_switch = relationship("Switch", foreign_keys=[resolved_switch_id])


class MacAddressEntry(Base):
    __tablename__ = "mac_address_entries"
    __table_args__ = (
        UniqueConstraint("switch_id", "vlan", "mac_address", name="uq_switch_vlan_mac"),
    )

    id = Column(Integer, primary_key=True)
    switch_id = Column(Integer, ForeignKey("switches.id"), nullable=False, index=True)
    vlan = Column(Integer, nullable=False)
    mac_address = Column(String(17), nullable=False, index=True)
    port = Column(String(32), nullable=False)
    entry_type = Column(String(16), nullable=True)  # "dynamic" / "static" など、不要なら省略可

    last_seen = Column(DateTime, default=datetime.utcnow, onupdate=datetime.utcnow, nullable=False)

    switch = relationship("Switch")


# 現在状態：1つのMAC/VLAN/スイッチの組につき1行のみ。ポーリングごとにupsert
class MacAddressEntry(Base):
    __tablename__ = "mac_address_entries"
    __table_args__ = (
        UniqueConstraint("switch_id", "vlan", "mac_address", name="uq_switch_vlan_mac"),
    )
    id = Column(Integer, primary_key=True)
    switch_id = Column(Integer, ForeignKey("switches.id"), nullable=False, index=True)
    vlan = Column(Integer, nullable=False)
    mac_address = Column(String(17), nullable=False, index=True)
    port = Column(String(32), nullable=False)
    first_seen = Column(DateTime, nullable=False)   # 今のポートに来た時刻
    last_seen = Column(DateTime, nullable=False)     # 直近のポーリングで確認できた時刻


# 履歴：変化（ポート移動・消失）があった時だけ1行追加
class MacAddressHistory(Base):
    __tablename__ = "mac_address_history"

    id = Column(Integer, primary_key=True)
    switch_id = Column(Integer, ForeignKey("switches.id"), nullable=False, index=True)
    vlan = Column(Integer, nullable=False)
    mac_address = Column(String(17), nullable=False, index=True)
    port = Column(String(32), nullable=False)
    valid_from = Column(DateTime, nullable=False)   # このポートに居た開始時刻
    valid_to = Column(DateTime, nullable=False)      # このポートから居なくなった時刻

class ArpEntry(Base):
    __tablename__ = "arp_entries"
    __table_args__ = (
        UniqueConstraint("switch_id", "vlan", "ip_address", name="uq_switch_vlan_ip"),
    )

    id = Column(Integer, primary_key=True)
    switch_id = Column(Integer, ForeignKey("switches.id"), nullable=False, index=True)  # 取得元のL3機器
    vlan = Column(Integer, nullable=False, index=True)
    ip_address = Column(String(45), nullable=False, index=True)
    mac_address = Column(String(17), nullable=False, index=True)

    first_seen = Column(DateTime, nullable=False)
    last_seen = Column(DateTime, nullable=False)

    switch = relationship("Switch")



