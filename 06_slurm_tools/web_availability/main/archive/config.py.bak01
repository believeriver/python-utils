# 表示グループの定義
# キー: サイドバーに表示するグループ名
# 値: そのグループに属するCSVカラム名のリスト
#
# ここを実データに合わせて編集すればOK。
# 例: 長崎/高砂/神戸で分けたい場合はグループを増やすだけでよい。
AREA_GROUPS = {
    "ライセンス": ["NASTRAN", "Abaqus", "FLUENT"],
    "並列計算機": ["Cluster01", "Cluster02", "Cluster03", "Cluster04"],
}

# 逼迫とみなす閾値(ランキング表示の色分けに使用)
WARNING_THRESHOLD = 90
CAUTION_THRESHOLD = 50
