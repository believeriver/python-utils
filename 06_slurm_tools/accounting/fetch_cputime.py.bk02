"""
SLURM billing base (Python 3.6) - dict dataset version.

Key points:
- sacct output is parsed into dict rows: {field: value, ...}
- dataset is also dict-based:
    dataset = {
        "parents": {jobid: parent_row_dict},
        "steps": {jobid: [step_row_dict, ...]},
        "step_sums": {jobid: {"TotalCPU_s":..., "UserCPU_s":..., "SystemCPU_s":...}},
        "final": {jobid: final_row_dict_with_seconds_and_billing_fields}
    }
- CPU aggregation policy:
    if any step rows exist for jobid -> use step sums only
    else -> use parent row CPU fields
- Interactive classification by SubmitLine: contains "--pty" or "salloc"
- Billing mode switchable by config
"""

import subprocess
import re
import sys
import math
import csv


# -----------------------------
# Config (edit here only)
# -----------------------------
class Config(object):
    DEFAULT_STARTTIME = "2026-01-01"

    # interactive detection keywords (lowercase check)
    INTERACTIVE_KEYWORDS = ["--pty", "salloc"]

    # if SubmitLine missing/empty: safe fallback to CPU billing (avoid overcharge)
    UNKNOWN_AS_CPU_BILLING = True

    # interactive billing: True -> CPUTime (occupied), False -> TotalCPU (actual)
    USE_OCCUPIED_FOR_INTERACTIVE = True

    # rounding
    ROUND_UNIT_SECONDS = 60
    ROUND_MODE = "ceil"   # "ceil" / "floor" / "round" / "none"
    MIN_BILLABLE_SECONDS = 0

    SACCT_PATH = "/usr/bin/sacct"


# -----------------------------
# Time / rounding utilities
# -----------------------------
class SlurmTime(object):
    @staticmethod
    def to_seconds(t):
        """
        Convert SLURM time string to seconds (float).
        Formats:
          - DD-HH:MM:SS[.mmm]
          - HH:MM:SS[.mmm]
          - MM:SS[.mmm]  (e.g. 18:07.645 or 00:00.054)
          - SS[.mmm]
        """
        if not t:
            return 0.0
        t = t.strip()
        if t == "Unknown":
            return 0.0

        t = t.replace(",", ".")
        days = 0

        if "-" in t:
            d, t = t.split("-", 1)
            try:
                days = int(d)
            except ValueError:
                days = 0

        parts = t.split(":")
        try:
            if len(parts) == 3:
                h = int(parts[0]); m = int(parts[1]); s = float(parts[2])
            elif len(parts) == 2:
                h = 0; m = int(parts[0]); s = float(parts[1])
            elif len(parts) == 1:
                h = 0; m = 0; s = float(parts[0])
            else:
                return 0.0
        except ValueError:
            return 0.0

        return days * 86400.0 + h * 3600.0 + m * 60.0 + s


class RoundingPolicy(object):
    def __init__(self, unit_seconds, mode, min_seconds=0):
        self.unit = float(unit_seconds) if unit_seconds and unit_seconds > 0 else 0.0
        self.mode = (mode or "none").lower()
        self.min_seconds = float(min_seconds) if min_seconds and min_seconds > 0 else 0.0

    def apply(self, seconds):
        if seconds < 0:
            seconds = 0.0

        # Minimum billable
        if self.min_seconds > 0 and seconds > 0 and seconds < self.min_seconds:
            seconds = self.min_seconds

        if self.mode == "none" or self.unit == 0.0:
            return seconds

        q = seconds / self.unit

        if self.mode == "ceil":
            return math.ceil(q) * self.unit
        if self.mode == "floor":
            return math.floor(q) * self.unit
        if self.mode == "round":
            # billing-friendly round: floor(x+0.5)
            return math.floor(q + 0.5) * self.unit

        return seconds


# -----------------------------
# Sacct schema + parser
# -----------------------------
class SacctSchema(object):
    """
    Single source of truth for sacct fields.
    If you want to change sacct --format, change FIELDS here.
    Downstream code should only reference keys, not column positions.
    """
    FIELDS = [
        "JobID",
        "Elapsed",
        "CPUTime",
        "TotalCPU",
        "UserCPU",
        "SystemCPU",
        "State",
        "SubmitLine",
        "JobName",
        "User",
        "Partition",
        "NCPUS",
        "AllocTRES",
        "NodeList",
        "End",
    ]

    @classmethod
    def format_arg(cls):
        return ",".join(cls.FIELDS)

    @classmethod
    def parse_line(cls, line):
        """
        Return dict row: {field: value, ...}
        parsable2 returns '|' separated fields in the order of --format.
        """
        cols = line.split("|")
        # tolerate missing trailing fields
        if len(cols) < len(cls.FIELDS):
            cols = cols + [""] * (len(cls.FIELDS) - len(cols))
        row = {}
        for i, k in enumerate(cls.FIELDS):
            row[k] = cols[i] if i < len(cols) else ""
        return row


class SacctClient(object):
    def __init__(self, sacct_path):
        self.sacct_path = sacct_path

    def fetch_rows(self, starttime, endtime="now"):
        cmd = [
            "ssh",
            "root@192.168.64.2",
            self.sacct_path,
            "--starttime", starttime,
            "--endtime", endtime,
            "--format", SacctSchema.format_arg(),
            "--parsable2",
            "-n",
        ]
        p = subprocess.run(
            cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, universal_newlines=True
        )
        if p.returncode != 0:
            sys.stderr.write("ERROR: sacct failed\n")
            sys.stderr.write(p.stderr)
            sys.exit(2)

        rows = []
        for line in p.stdout.splitlines():
            if not line.strip():
                continue
            rows.append(SacctSchema.parse_line(line))
        return rows


# -----------------------------
# Dataset builder (dict-based)
# -----------------------------
class DatasetBuilder(object):
    """
    Build dict dataset from sacct dict rows.
    """
    STEP_RE = re.compile(r"^(\d+)\.(.+)$")
    JOB_RE = re.compile(r"^\d+$")

    def build(self, rows):
        dataset = {
            "parents": {},     # jobid -> parent row dict
            "steps": {},       # jobid -> list of step row dict
        }

        for r in rows:
            jobid = (r.get("JobID") or "").strip()

            m = self.STEP_RE.match(jobid)
            if m:
                parent = m.group(1)
                dataset["steps"].setdefault(parent, []).append(r)
                continue

            if self.JOB_RE.match(jobid):
                # keep parent row
                dataset["parents"][jobid] = r
                continue

        return dataset


# -----------------------------
# Aggregation + classification + billing (dict-in, dict-out)
# -----------------------------
class BillingPipeline(object):
    def __init__(self, cfg):
        self.cfg = cfg
        self.rounding = RoundingPolicy(cfg.ROUND_UNIT_SECONDS, cfg.ROUND_MODE, cfg.MIN_BILLABLE_SECONDS)

    def is_interactive(self, submitline):
        if not submitline:
            return None  # unknown
        s = submitline.lower()
        for k in self.cfg.INTERACTIVE_KEYWORDS:
            if k in s:
                return True
        return False

    def sum_steps_cpu(self, step_rows):
        """
        Sum TotalCPU/UserCPU/SystemCPU from step rows.
        Returns dict with *_s keys.
        """
        total = 0.0
        user = 0.0
        sysc = 0.0
        for r in step_rows:
            total += SlurmTime.to_seconds(r.get("TotalCPU", ""))
            user += SlurmTime.to_seconds(r.get("UserCPU", ""))
            sysc += SlurmTime.to_seconds(r.get("SystemCPU", ""))
        return {"TotalCPU_s": total, "UserCPU_s": user, "SystemCPU_s": sysc}

    def pick_cpu_source(self, parent_row, step_rows):
        """
        CPU aggregation policy:
          - if step rows exist -> use step sums (avoid double-count)
          - else -> use parent row CPU fields (needed for some srun jobs)
        """
        if step_rows:
            sums = self.sum_steps_cpu(step_rows)
            sums["CPU_source"] = "steps"
            return sums

        # parent fallback
        sums = {
            "TotalCPU_s": SlurmTime.to_seconds(parent_row.get("TotalCPU", "")),
            "UserCPU_s": SlurmTime.to_seconds(parent_row.get("UserCPU", "")),
            "SystemCPU_s": SlurmTime.to_seconds(parent_row.get("SystemCPU", "")),
            "CPU_source": "parent",
        }
        return sums

    def bill_seconds(self, parent_row, cpu_sums):
        """
        Determine bill seconds based on interactive/batch and config.
        Returns dict: bill_mode, raw, rounded, interactive, decision_note
        """
        elapsed_s = SlurmTime.to_seconds(parent_row.get("Elapsed", ""))
        cputime_s = SlurmTime.to_seconds(parent_row.get("CPUTime", ""))  # occupied = elapsed*ncpus
        totalcpu_s = cpu_sums["TotalCPU_s"]

        submit = (parent_row.get("SubmitLine") or "").strip()
        interactive = self.is_interactive(submit)

        if interactive is True and self.cfg.USE_OCCUPIED_FOR_INTERACTIVE:
            raw = cputime_s
            mode = "occupied"
            note = "interactive -> CPUTime"
        elif interactive is True and not self.cfg.USE_OCCUPIED_FOR_INTERACTIVE:
            raw = totalcpu_s
            mode = "cpu"
            note = "interactive -> TotalCPU"
        elif interactive is False:
            raw = totalcpu_s
            mode = "cpu"
            note = "batch -> TotalCPU"
        else:
            # unknown (missing SubmitLine)
            if self.cfg.UNKNOWN_AS_CPU_BILLING:
                raw = totalcpu_s
                mode = "cpu"
                note = "SubmitLine missing -> safe TotalCPU"
            else:
                raw = cputime_s
                mode = "occupied"
                note = "SubmitLine missing -> occupied"

        rounded = self.rounding.apply(raw)

        return {
            "Elapsed_s": elapsed_s,
            "CPUTime_s": cputime_s,
            "BillMode": mode,
            "BillSeconds_raw": raw,
            "BillSeconds_rounded": rounded,
            "Interactive": interactive,
            "DecisionNote": note,
            "SubmitLine_present": True if submit else False,
        }

    def run(self, dataset):
        """
        dataset in:
          {"parents":{jobid:row}, "steps":{jobid:[row,...]}}
        dataset out:
          dataset["step_sums"], dataset["final"]
        """
        parents = dataset.get("parents", {})
        steps = dataset.get("steps", {})

        dataset["step_sums"] = {}  # jobid -> cpu sums dict
        dataset["final"] = {}      # jobid -> final dict (flattened for report)

        for jobid, prow in parents.items():
            step_rows = steps.get(jobid, [])
            cpu_sums = self.pick_cpu_source(prow, step_rows)
            dataset["step_sums"][jobid] = cpu_sums

            bill = self.bill_seconds(prow, cpu_sums)

            # build final row dict (still dict-based)
            final = {}
            # copy some meta fields (use keys; missing ok)
            for k in ["JobID", "User", "JobName", "Partition", "NCPUS", "NodeList", "AllocTRES", "End", "State", "SubmitLine"]:
                final[k] = prow.get(k, "")

            # add seconds fields
            final.update(cpu_sums)
            final.update(bill)

            dataset["final"][jobid] = final

        return dataset


# -----------------------------
# Reporting
# -----------------------------
class Reporter(object):
    @staticmethod
    def print_table(final_map):
        # Minimal audit-friendly columns (same idea as before)
        header = [
            "JobID", "User", "JobName", "Part", "NCPUS",
            "Elapsed(s)", "CPUTime(s)", "TotalCPU(s)",
            "BillMode", "Bill(raw)", "Bill(rounded)",
            "Submit", "CPUfrom"
        ]
        fmt = "{:<6s} {:<8s} {:<10s} {:<6s} {:>5s} {:>10s} {:>10s} {:>10s} {:<9s} {:>10s} {:>12s} {:<6s} {:<6s}"
        print(fmt.format(*header))

        for jid in sorted(final_map.keys(), key=lambda x: int(x)):
            r = final_map[jid]
            submit_flag = "Y" if r.get("SubmitLine_present") else "N"
            row = [
                str(r.get("JobID", jid)),
                (r.get("User", "") or "")[:8],
                (r.get("JobName", "") or "")[:10],
                (r.get("Partition", "") or "")[:6],
                str(r.get("NCPUS", "")),
                "{:.1f}".format(r.get("Elapsed_s", 0.0)),
                "{:.1f}".format(r.get("CPUTime_s", 0.0)),
                "{:.3f}".format(r.get("TotalCPU_s", 0.0)),
                r.get("BillMode", ""),
                "{:.3f}".format(r.get("BillSeconds_raw", 0.0)),
                "{:.3f}".format(r.get("BillSeconds_rounded", 0.0)),
                submit_flag,
                r.get("CPU_source", ""),
            ]
            print(fmt.format(*row))

    @staticmethod
    def write_csv(path, final_map):
        # Write everything useful for audit
        fields = [
            "JobID", "End", "User", "JobName", "Partition", "NodeList", "NCPUS", "AllocTRES",
            "State", "SubmitLine",
            "Elapsed_s", "CPUTime_s",
            "TotalCPU_s", "UserCPU_s", "SystemCPU_s",
            "CPU_source",
            "Interactive", "BillMode", "BillSeconds_raw", "BillSeconds_rounded", "DecisionNote"
        ]
        with open(path, "w", newline="") as f:
            w = csv.DictWriter(f, fieldnames=fields)
            w.writeheader()
            for jid in sorted(final_map.keys(), key=lambda x: int(x)):
                r = final_map[jid]
                w.writerow({
                    "JobID": r.get("JobID", jid),
                    "End": r.get("End", ""),
                    "User": r.get("User", ""),
                    "JobName": r.get("JobName", ""),
                    "Partition": r.get("Partition", ""),
                    "NodeList": r.get("NodeList", ""),
                    "NCPUS": r.get("NCPUS", ""),
                    "AllocTRES": r.get("AllocTRES", ""),
                    "State": r.get("State", ""),
                    "SubmitLine": r.get("SubmitLine", ""),
                    "Elapsed_s": r.get("Elapsed_s", 0.0),
                    "CPUTime_s": r.get("CPUTime_s", 0.0),
                    "TotalCPU_s": r.get("TotalCPU_s", 0.0),
                    "UserCPU_s": r.get("UserCPU_s", 0.0),
                    "SystemCPU_s": r.get("SystemCPU_s", 0.0),
                    "CPU_source": r.get("CPU_source", ""),
                    "Interactive": r.get("Interactive"),
                    "BillMode": r.get("BillMode", ""),
                    "BillSeconds_raw": r.get("BillSeconds_raw", 0.0),
                    "BillSeconds_rounded": r.get("BillSeconds_rounded", 0.0),
                    "DecisionNote": r.get("DecisionNote", ""),
                })


# -----------------------------
# App
# -----------------------------
def parse_args(argv):
    # billing_slurm_cpu.py [starttime] [--csv out.csv]
    starttime = Config.DEFAULT_STARTTIME
    csv_path = None

    i = 1
    while i < len(argv):
        a = argv[i]
        if a == "--csv" and i + 1 < len(argv):
            csv_path = argv[i + 1]
            i += 2
            continue
        starttime = a
        i += 1

    return starttime, csv_path


def main(argv):
    starttime, csv_path = parse_args(argv)

    client = SacctClient(Config.SACCT_PATH)
    rows = client.fetch_rows(starttime=starttime, endtime="now")

    dataset = DatasetBuilder().build(rows)
    dataset = BillingPipeline(Config).run(dataset)

    final_map = dataset.get("final", {})
    Reporter.print_table(final_map)

    if csv_path:
        Reporter.write_csv(csv_path, final_map)
        print("\nCSV written to: {}".format(csv_path))


if __name__ == "__main__":
    main(sys.argv)